{
  "name": "@agritrace/portal",
  "private": true,
  "version": "0.1.0",
  "description": "AgriTrace FPO admin web portal (React 18 + TypeScript strict + Vite).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MSW=true vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript ../../packages/openapi/openapi.json -o src/api/generated/schema.d.ts && node scripts/gen-error-messages.ts",
    "gen:check": "npm run gen:api && git diff --exit-code -- src/api/generated && test -z \"$(git status --porcelain -- src/api/generated)\"",
    "size": "node scripts/bundle-size.ts"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "6.0.2",
    "@mui/material": "9.5.0",
    "@tanstack/react-query": "5.105.0",
    "openapi-fetch": "0.17.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "63.3.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
