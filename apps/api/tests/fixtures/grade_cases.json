{
  "_about": "Shared grade-engine cases (D-006): run verbatim by apps/api/tests/unit/test_grade_engine.py and by the Dart preview engine (M03). A string `profile` names either a key of `profiles` below or a file apps/api/agritrace/modules/quality/profiles/<name>.json. Serves FR44, FR48-FR50, FR68, Dataflow Stages 5, 7, 8, backend-design.md §4. Readings: {parameter_code, value, unit, stage, source, measured_at?, lab_nabl_no?}. Saffron thresholds are placeholders (edition LOAD_FROM_STANDARD), not ISO 3632 values.",
  "profiles": {
    "turmeric_agmark_test": {
      "schema_version": 1,
      "standard": { "name": "AGMARK — Turmeric Whole", "schedule": "II", "edition": "LOAD_FROM_STANDARD", "clause_ref": "LOAD_FROM_STANDARD" },
      "grades": ["Special", "Standard"],
      "fail_grade": "Below grade",
      "parameters": [
        { "code": "moisture", "unit": "%", "required": true, "capture_stages": ["drying_end", "intake", "grading"],
          "limits": { "Special": { "max": 11.0 }, "Standard": { "max": 12.0 } }, "plausible": { "min": 0, "max": 100 } },
        { "code": "curcuminoid", "unit": "%", "required": true,
          "limits": { "Special": { "min": 3.0 }, "Standard": { "min": 2.0 } }, "plausible": { "min": 0, "max": 15 } },
        { "code": "lead_chromate", "unit": "result", "required": true, "limits": null, "status": "load_from_standard" }
      ]
    },
    "saffron_iso3632_test": {
      "schema_version": 1,
      "standard": { "name": "ISO 3632-1 Saffron — Specification", "edition": "LOAD_FROM_STANDARD", "clause_ref": "LOAD_FROM_STANDARD" },
      "grades": ["I", "II", "III"],
      "fail_grade": "Not categorised",
      "parameters": [
        { "code": "moisture", "unit": "%", "required": true,
          "limits": { "I": { "max": 12.0 }, "II": { "max": 12.0 }, "III": { "max": 12.0 } }, "plausible": { "min": 0, "max": 100 } },
        { "code": "crocin_e440", "name_en": "Colouring strength (crocin, 440 nm)", "unit": "E1%", "required": true,
          "limits": { "I": { "min": 200 }, "II": { "min": 170 }, "III": { "min": 120 } }, "sources_allowed": ["lab"] },
        { "code": "picrocrocin_e257", "name_en": "Bitterness (picrocrocin, 257 nm)", "unit": "E1%", "required": true,
          "limits": { "I": { "min": 70 }, "II": { "min": 55 }, "III": { "min": 40 } }, "sources_allowed": ["lab"] },
        { "code": "safranal_e330", "name_en": "Aroma (safranal, 330 nm)", "unit": "E1%", "required": true,
          "limits": { "I": { "min": 20, "max": 50 }, "II": { "min": 20, "max": 50 }, "III": { "min": 20, "max": 50 } }, "sources_allowed": ["lab"] }
      ],
      "lab_certified_requires": { "any_parameter_source": "lab", "nabl_no_present": true }
    },
    "coffee_ico420_test": {
      "schema_version": 1,
      "standard": { "name": "ICO Resolution 420; moisture by ISO 6673", "edition": "LOAD_FROM_STANDARD", "clause_ref": "LOAD_FROM_STANDARD" },
      "grades": ["S"],
      "fail_grade": "XM",
      "parameters": [
        { "code": "moisture", "unit": "%", "required": true, "method_ref": "ISO 6673",
          "limits": { "S": { "min": 8.0, "max": 12.5 } }, "plausible": { "min": 0, "max": 100 }, "exception_flags": ["monsooned"] }
      ]
    }
  },
  "compute": [
