# Environment for running the API, worker, alembic or tests on the host against `make up`.
# Serves: Arch §Backend services (twelve-factor config); read by agritrace/core/config.py.
# Callers: copy to apps/api/.env (git-ignored). Inside docker compose the values come from
# infra/docker-compose.yml instead (service host names db, valkey, s3).

# Deployment environment: dev | test | prod. prod refuses the dev JWT_SECRET and any OTP_DEV_CODE.
ENV=dev
# Postgres 16 + PostGIS, async driver. Change the port if you remapped DB_PORT.
DATABASE_URL=postgresql+asyncpg://agritrace:agritrace@localhost:5432/agritrace
# Redis-protocol URL (Valkey locally, D-021): Celery broker and cache.
REDIS_URL=redis://localhost:6379/0
# S3 endpoint the API and worker call: LocalStack locally (D-008), AWS S3 in production.
S3_ENDPOINT=http://localhost:4566
# S3 endpoint phones and browsers reach; presigned upload URLs are built against it.
# Inside compose S3_ENDPOINT is http://s3:4566 while this stays http://localhost:<S3_PORT>;
# for a phone on the LAN use the laptop's LAN IP. In production both are the AWS S3 endpoint.
S3_PUBLIC_ENDPOINT=http://localhost:4566
# S3 region used for signing.
S3_REGION=ap-south-1
# S3 credentials (LocalStack accepts test/test; an IAM role in production).
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
# Write-once evidence photos (versioning + object lock, D-008).
S3_BUCKET_EVIDENCE=evidence
# Built public batch pages, anonymous read (D-007).
S3_BUCKET_PUBLIC=public-pages
# Farmer identity documents, private.
S3_BUCKET_IDDOCS=id-docs
# Base URL a consumer opens for a public batch page (CDN in production).
PUBLIC_BASE_URL=http://localhost:4566/public-pages
# HMAC secret for access tokens. Must be a long random value in prod.
JWT_SECRET=dev-only-change-me
# Fixed OTP accepted outside prod so testers need no SMS. Leave empty in prod.
OTP_DEV_CODE=123456
