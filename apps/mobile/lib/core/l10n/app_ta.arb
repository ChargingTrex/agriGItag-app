      "attempts": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "errorPinLocked": "பல முறை தவறான PIN. {minutes} நிமிடத்தில் மீண்டும் முயலவும்.",
  "@errorPinLocked": {
    "description": "Shown for API error pin_locked (5 wrong PINs lock sign-in for 5 minutes); minutes until details.locked_until, rounded up.",
    "placeholders": {
      "minutes": {
        "type": "int",
        "example": "5"
      }
    }
  },
  "errorRateLimited": "புதிய குறியீடு கேட்க {minutes} நிமிடம் காத்திருக்கவும்.",
  "@errorRateLimited": {
    "description": "Shown for API error rate_limited on code requests; minutes from details.retry_after_s, rounded up.",
    "placeholders": {
      "minutes": {
        "type": "int",
        "example": "1"
      }
    }
  },
  "errorDeviceInUse": "இந்தக் கைபேசி வேறொருவர் பெயரில் உள்நுழைந்துள்ளது. முதலில் வெளியேறவும்.",
  "@errorDeviceInUse": {
    "description": "Sheet text for API error device_in_use (a shared phone still signed in for another user)."
  },
  "errorSignInExpired": "உள்நுழைவு நேரம் முடிந்தது. மீண்டும் தொடங்கவும்.",
  "@errorSignInExpired": {
    "description": "Shown when the 5-minute PIN step ran out (API 401 on PIN verify)."
  },
  "errorPhoneInvalid": "கைபேசி எண்ணைச் சரிபார்க்கவும்.",
  "@errorPhoneInvalid": {
    "description": "Shown when the API rejects the phone number (validation_error)."
  },
  "errorNetwork": "சிக்னல் இல்லை. சிக்னல் வந்ததும் மீண்டும் முயலவும்.",
  "@errorNetwork": {
    "description": "Shown when a sign-in request got no answer (no network)."
  },
  "errorPortalOnly": "இந்தக் கணக்கு இணைய தளத்தில் மட்டுமே செயல்படும், கைபேசியில் அல்ல.",
  "@errorPortalOnly": {
    "description": "Shown when an FPO admin or viewer signs in on the phone app; their work is on the web portal."
  },
  "errorUnknown": "ஏதோ தவறு நடந்தது. மீண்டும் முயலவும்.",
  "@errorUnknown": {
    "description": "Shown for any other sign-in failure; the error code itself is never shown."
  },
  "sessionEnded": "நீங்கள் வெளியேற்றப்பட்டீர்கள். மீண்டும் உள்நுழையவும்.",
  "@sessionEnded": {
    "description": "Shown on the phone step when the server ended the session (refresh token reused or the phone was signed out remotely)."
  },
  "signOut": "வெளியேறு",
  "@signOut": {
    "description": "Button that signs this phone out (settings, and the device-in-use sheet); at most two words."
  },
  "settingsTitle": "அமைப்புகள்",
  "@settingsTitle": {
    "description": "Title of the settings screen and tooltip of the gear icon that opens it."
  },
  "unsentReminder": "இன்னும் அனுப்பப்படாத பதிவுகள்: {count}. அவை இந்தக் கைபேசியிலேயே இருக்கும்; அனுப்ப சிக்னல் பெறவும்.",
  "@unsentReminder": {
    "description": "Reminder on the settings screen above Sign out when the outbox still holds unsent entries.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  }
}
