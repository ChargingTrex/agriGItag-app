{
  "@@locale": "en",
  "appTitle": "AgriTrace",
  "@appTitle": {
    "description": "App name shown in the app bar and the OS task switcher."
  },
  "signIn": "Sign in",
  "@signIn": {
    "description": "App bar title of the sign-in steps (phone, code, PIN); at most two words."
  },
  "roleFarmer": "Farmer",
  "@roleFarmer": {
    "description": "Role name of a farmer, shown on the farmer home placeholder."
  },
  "roleFieldOfficer": "Field officer",
  "@roleFieldOfficer": {
    "description": "Role name of an FPO field officer, shown on the officer home placeholder."
  },
  "roleQc": "QC officer",
  "@roleQc": {
    "description": "Role name of a quality-check (grading) officer, shown on the QC home placeholder."
  },
  "assistFor": "Helping {farmerId}",
  "@assistFor": {
    "description": "Title of the assist-mode placeholder: the field officer is entering data for this farmer.",
    "placeholders": {
      "farmerId": {
        "type": "String",
        "example": "F-0042"
      }
    }
  },
  "switchLanguage": "தமிழ்",
  "@switchLanguage": {
    "description": "Label of the one-button language switch. It names the language the app switches TO, written in that language."
  },
  "playVoice": "Play voice",
  "@playVoice": {
    "description": "Screen-reader label of the speaker icon that plays the recorded voice prompt for a button."
  },
  "statusDone": "Done",
  "@statusDone": {
    "description": "Status badge text next to the green tick: the task or entry is done (server confirmed). At most two words."
  },
  "statusTodo": "To do",
  "@statusTodo": {
    "description": "Status badge text next to the orange circle: still to do. At most two words."
  },
  "statusAttention": "Needs attention",
  "@statusAttention": {
    "description": "Status badge text next to the red triangle: something needs attention. At most two words."
  },
  "stepperLess": "Less",
  "@stepperLess": {
    "description": "Screen-reader label of the big minus button of a quantity stepper."
  },
  "stepperMore": "More",
  "@stepperMore": {
    "description": "Screen-reader label of the big plus button of a quantity stepper."
  },
  "numberPadDelete": "Delete",
  "@numberPadDelete": {
    "description": "Screen-reader label of the number pad's backspace key (removes the last digit)."
  },
  "numberPadPoint": "Point",
  "@numberPadPoint": {
    "description": "Screen-reader label of the number pad's decimal point key."
  },
  "voiceMissing": "No voice",
  "@voiceMissing": {
    "description": "Screen-reader label of the greyed speaker when no recorded clip exists for this screen; the text is shown instead."
  },
  "callOfficer": "Call officer",
  "@callOfficer": {
    "description": "Label of the button on every farmer screen that phones the farmer's field officer. At most two words. Also the voice prompt id of its recorded clip."
  },
  "confirmCorrect": "Correct",
  "@confirmCorrect": {
    "description": "Label of the big tick on the confirm screen: the farmer agrees the entry is right and saves it. At most two words."
  },
  "retake": "Retake",
  "@retake": {
    "description": "Label of the button that discards the photo and opens the camera again. At most two words."
  },
  "cloudPending": "{count} waiting to send",
  "@cloudPending": {
    "description": "Screen-reader label of the grey cloud: this many entries are saved on the phone and not yet sent.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "cloudAllSent": "All sent",
  "@cloudAllSent": {
    "description": "Screen-reader label of the green tick that replaces the cloud when nothing is waiting to send."
  },
  "loggingFor": "Logging for: {name}",
  "@loggingFor": {
    "description": "Assist-mode top bar: the field officer is entering data on behalf of this farmer.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Murugan"
      }
    }
  },
  "gpsHold": "Hold the phone up, finding your location",
  "@gpsHold": {
    "description": "Sentence under the filling GPS ring while the location is not yet accurate. Also the voice prompt id of its recorded clip."
  },
  "gpsFound": "Location found",
  "@gpsFound": {
    "description": "Sentence under the GPS ring once it turns green (accuracy 20 m or better)."
  },
  "gpsAccuracy": "± {metres} m",
  "@gpsAccuracy": {
    "description": "Current GPS accuracy under the ring, in whole metres.",
    "placeholders": {
      "metres": {
        "type": "int",
        "example": "35"
      }
    }
  },
  "saveAnyway": "Save anyway",
  "@saveAnyway": {
    "description": "Button shown 60 seconds into a weak GPS fix: saves the location with its low accuracy (flagged for the field officer). At most two words."
  },
  "photoNotClear": "Photo is not clear. Take again?",
  "@photoNotClear": {
    "description": "Error sheet sentence when the photo is too dark or blurry (UserFlows §When things go wrong). Also a voice prompt id."
  },
  "authPhoneTitle": "Enter mobile number",
  "@authPhoneTitle": {
    "description": "Prompt of the first sign-in step (F01): the farmer's or officer's mobile number, typed on the on-screen keypad."
  },
  "authGetCode": "Get code",
  "@authGetCode": {
    "description": "Button on the phone step that asks for the SMS sign-in code; at most two words."
  },
  "authOtpTitle": "Enter the 6-digit code from the SMS",
  "@authOtpTitle": {
    "description": "Prompt of the OTP step; the app usually fills the code in from the SMS by itself."
  },
  "authResend": "Send again",
  "@authResend": {
    "description": "Button on the OTP step that asks for a new SMS code; at most two words."
  },
  "authPinTitle": "Enter your 4-digit PIN",
  "@authPinTitle": {
    "description": "Prompt of the PIN step for field and QC officers who already have a PIN."
  },
  "authPinChoose": "Choose a 4-digit PIN",
  "@authPinChoose": {
    "description": "Prompt on an officer's first sign-in: choose the PIN (entered twice)."
  },
  "authPinRepeat": "Enter the same PIN again",
  "@authPinRepeat": {
    "description": "Prompt for the second entry of a newly chosen PIN."
  },
  "authPinMismatch": "The two PINs are different. Choose again.",
  "@authPinMismatch": {
    "description": "One sentence shown when the second entry of a new PIN does not match the first."
  },
  "authStartAgain": "Start again",
  "@authStartAgain": {
    "description": "Button that goes back to the phone step after the PIN step timed out; at most two words."
  },
  "authDelete": "Delete",
  "@authDelete": {
    "description": "Screen-reader label of the delete (backspace) key on the sign-in keypad."
  },
  "errorOtpInvalid": "Wrong code. Check the SMS and try again.",
  "@errorOtpInvalid": {
    "description": "Shown for API error otp_invalid (wrong SMS code)."
  },
  "errorOtpExpired": "This code is too old. Tap Send again.",
  "@errorOtpExpired": {
    "description": "Shown for API error otp_expired (the code is older than 5 minutes)."
  },
  "errorOtpLocked": "Too many wrong codes. Tap Send again for a new one.",
  "@errorOtpLocked": {
    "description": "Shown for API error otp_locked (5 wrong codes)."
  },
  "errorPinInvalid": "Wrong PIN. {attempts} tries left.",
  "@errorPinInvalid": {
    "description": "Shown for API error pin_invalid; attempts is details.attempts_left.",
    "placeholders": {
      "attempts": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "errorPinLocked": "Too many wrong PINs. Try again in {minutes} min.",
  "@errorPinLocked": {
    "description": "Shown for API error pin_locked (5 wrong PINs lock sign-in for 5 minutes); minutes until details.locked_until, rounded up.",
    "placeholders": {
      "minutes": {
        "type": "int",
        "example": "5"
      }
    }
  },
  "errorRateLimited": "Please wait {minutes} min before asking for a new code.",
  "@errorRateLimited": {
    "description": "Shown for API error rate_limited on code requests; minutes from details.retry_after_s, rounded up.",
    "placeholders": {
      "minutes": {
        "type": "int",
        "example": "1"
      }
    }
  },
  "errorDeviceInUse": "This phone is signed in as someone else. Sign out first.",
  "@errorDeviceInUse": {
    "description": "Sheet text for API error device_in_use (a shared phone still signed in for another user)."
  },
  "errorSignInExpired": "Sign-in took too long. Start again.",
  "@errorSignInExpired": {
    "description": "Shown when the 5-minute PIN step ran out (API 401 on PIN verify)."
  },
  "errorPhoneInvalid": "Check the mobile number.",
  "@errorPhoneInvalid": {
    "description": "Shown when the API rejects the phone number (validation_error)."
  },
  "errorNetwork": "No signal. Try again when signal comes.",
  "@errorNetwork": {
    "description": "Shown when a sign-in request got no answer (no network)."
  },
  "errorPortalOnly": "This account works on the web portal, not on the phone.",
  "@errorPortalOnly": {
    "description": "Shown when an FPO admin or viewer signs in on the phone app; their work is on the web portal."
  },
  "errorUnknown": "Something went wrong. Try again.",
  "@errorUnknown": {
    "description": "Shown for any other sign-in failure; the error code itself is never shown."
  },
  "sessionEnded": "You were signed out. Please sign in again.",
  "@sessionEnded": {
    "description": "Shown on the phone step when the server ended the session (refresh token reused or the phone was signed out remotely)."
  },
